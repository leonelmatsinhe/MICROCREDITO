[TEMPLATE]
# ─────────────────────────────────────────────────────────────────────────────
# MBR Microcrédito — MODO SINGLE-TENANT (uma só empresa por instalação)
#
# Copiar estas linhas para o .env real da instalação dedicada (ou colar no
# painel do Dokploy / systemd / PM2). NUNCA commitar o .env real.
#
# Em modo single:
#   · o companyId que vem do cliente (URL, query ou body) é IGNORADO e
#     substituído por SINGLE_TENANT_COMPANY_ID — ver src/middlewares/tenantGuard.ts;
#   · qualquer tentativa de usar outro companyId é registada como WARNING
#     ([TenantGuard] AVISO DE SEGURANÇA ...);
#   · o registo público de empresas, o painel Super Admin (/api/super-admin/*)
#     e o debug de empresas (/api/debug/companies) ficam DESACTIVADOS em
#     src/routes.ts — não fazem sentido numa instalação de uma só empresa.
# ─────────────────────────────────────────────────────────────────────────────

# Activa o isolamento: 'single' (empresa única) ou 'multi' (omisso = multi-empresa)
TENANT_MODE=single

# Id da empresa ÚNICA desta instalação (coluna companies.id).
# Se não existir, o sistema assume 1.
# ATENÇÃO: tem de ser o id REAL da empresa desta instalação — confirme com
#   SELECT id, companyName FROM companies;
# (numa instalação existente o id pode não ser 1, ex.: 36 = MBR Microcrédito).
SINGLE_TENANT_COMPANY_ID=1
