# ─────────────────────────────────────────────────────────────────────────────
# MBR Microcrédito — variáveis de ambiente de produção
# Copiar para .env (VPS sem Dokploy) ou colar no painel do Dokploy (Environment).
# NUNCA commitar o .env real (já está no .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de dados (MySQL externo) ──
DATABASE_HOST=127.0.0.1
DATABASE_NAME=mbr_microcredito
DATABASE_USER=microcredito
DATABASE_PASS=trocar-esta-palavra-passe

# ── Servidor ──
PORT=4000
# Fuso dos documentos legais (recibos/extractos/pacotes)
TZ=Africa/Maputo

# ── Segredos de segurança (GERAR NOVOS em produção: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ──
# Assinatura dos tokens JWT
APP_SECRET=trocar-por-segredo-longo
# Sal do hash AT dos recibos — se mudar, todos os hashes impressos deixam de validar
RECIBO_HASH_SECRET=trocar-por-segredo-longo

# ── URLs públicas (link impresso no QR/validação dos recibos) ──
PUBLIC_BASE_URL=https://maismola.co.mz
# PUBLIC_VALIDATION_URL=https://maismola.co.mz

# ── Certificação AT (Decreto 22/2023) ──
# false: PDF sem selo (QR/hash/código AT não impressos); lógica e validação pública continuam activas.
# true: imprimir selo — só quando existir o Certificado AT 2026/001.
AT_CERTIFICADO_ENABLED=false

# ── MIGRAÇÕES / ARRANQUE ──
# As migrações e o arranque do servidor NUNCA criam nem alteram carteiras de
# financiadores — o seed foi removido do código. Carteiras são criadas e
# geridas exclusivamente pelo Admin na interface.

# ── E-mail (SMTP — envio de credenciais e recibos) ──
EMAIL_HOST=mail.outboxsolutions.co.mz
EMAIL_PORT=587
EMAIL_USER=
EMAIL_SECRET=

# ── SMS (BulkSMM — fila processada a cada 60s; sem chave a fila fica intacta) ──
BULKSMS_API_KEY=
BULKSMS_API_URL=
BULKSMS_SENDER_ID=

# ── IA (AI Bot — DESACTIVADO no sistema; módulo mantido em src/modules/aiBot) ──
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Empresa por omissão (multi-empresa) ──
COMPANY_DEFAULT_ID=

# ── Caminhos (por omissão relativos à raiz; normalmente não mexer) ──
# PUBLIC_DIR=/app/public-v2
# UPLOADS_DIR=/app/uploads

# ── Debug (NUNCA em produção) ──
# LEGAL_DOCS_DEBUG=1
