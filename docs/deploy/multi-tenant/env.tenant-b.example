# ═══════════════════════════════════════════════════════════════════
#  TENANT B — DEMO
#  Copiar para: /opt/microcredito/tenant-b/.env   (chmod 600)
#
#  Nota: PORT e DATABASE_NAME são TAMBÉM forçados pelo ecosystem.config.cjs
#  (bloco env do app "microcredito-demo"). Mantêm-se aqui iguais para os
#  casos em que se corre dentro da pasta: `npm run migrate`, etc.
# ═══════════════════════════════════════════════════════════════════

# ── Servidor ──────────────────────────────────────────────────────
PORT=4001
TZ=Africa/Maputo
PUBLIC_BASE_URL=https://demo.tuaempresa.co.mz

# ── Segredos (diferentes do prod — gere com openssl rand -hex 32) ──
APP_SECRET=
RECIBO_HASH_SECRET=

# ── Base de dados (UMA POR TENANT — NUNCA partilhar com o prod) ───
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=microcredito_b
DATABASE_USER=microcredito_b
DATABASE_PASS=

# ── Single-tenant: o tenantGuard força sempre o companyId abaixo ──
TENANT_MODE=single
COMPANY_DEFAULT_ID=1
SINGLE_TENANT_COMPANY_ID=1

# ── M-Pesa (demo: normalmente vazio/chaves de teste) ──────────────
MPESA_PUBLIC_KEY=
MPESA_API_HOST=
MPESA_API_KEY=
MPESA_ORIGIN=
MPESA_SERVICE_PROVIDER_CODE=

# ── E-mail (opcional) ─────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_SECRET=

# ── SMS (BulkSMS) — demo pode ficar vazio: nada é enfileirado ─────
BULKSMS_API_KEY=
BULKSMS_API_URL=
BULKSMS_SENDER_ID=

# ── Documentos legais / AT ────────────────────────────────────────
AT_CERTIFICADO_ENABLED=0
