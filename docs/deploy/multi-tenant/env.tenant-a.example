# ═══════════════════════════════════════════════════════════════════
#  TENANT A — PROD
#  Copiar para: /opt/microcredito/tenant-a/.env   (chmod 600)
#
#  Nota: PORT e DATABASE_NAME definem o endpoint DESTE tenant (o ecosystem
#  não os sobrescreve — migrate e runtime leem sempre o mesmo .env).
#  Prod existente: pode manter o nome da BD actual (ex.: mbr_microcredito)
#  em DATABASE_NAME — não é preciso renomear nada.
# ═══════════════════════════════════════════════════════════════════

# ── Servidor ──────────────────────────────────────────────────────
PORT=4000
TZ=Africa/Maputo
PUBLIC_BASE_URL=https://a.tuaempresa.co.mz

# ── Segredos (100% únicos por tenant — gere com openssl rand -hex 32) ──
APP_SECRET=
RECIBO_HASH_SECRET=

# ── Base de dados (UMA POR TENANT) ────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=microcredito_a
DATABASE_USER=microcredito_a
DATABASE_PASS=

# ── Single-tenant: o tenantGuard força sempre o companyId abaixo ──
TENANT_MODE=single
COMPANY_DEFAULT_ID=1
SINGLE_TENANT_COMPANY_ID=1

# ── M-Pesa ────────────────────────────────────────────────────────
MPESA_PUBLIC_KEY=
MPESA_API_HOST=
MPESA_API_KEY=
MPESA_ORIGIN=
MPESA_SERVICE_PROVIDER_CODE=

# ── E-mail (opcional) ─────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_SECRET=

# ── SMS (BulkSMS) ─────────────────────────────────────────────────
BULKSMS_API_KEY=
BULKSMS_API_URL=
BULKSMS_SENDER_ID=

# ── Documentos legais / AT ────────────────────────────────────────
AT_CERTIFICADO_ENABLED=0
